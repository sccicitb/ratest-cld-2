# --- App data store (§9.1) ---
DATABASE_URL=sqlite:///./data/app.db

# --- Vector store (§9.2) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_chunks

# --- Chat model: any OpenAI-compatible endpoint (§7, §12) ---
MODEL_BASE_URL=https://llama.sccic.org/v1
MODEL_NAME=qwen
MODEL_API_KEY=not-needed

# --- Embeddings / rerank (FlagEmbedding/BGE-M3, in-process; §8.1/§8.5) ---
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=false
# Device auto-detects cuda → mps (Mac M1) → cpu. Override if needed.
EMBED_DEVICE=auto
# EMBED_USE_FP16=   # blank = auto (fp16 only on cuda)

# --- Ingress routing (§6) — token count is the real gate, not bytes ---
INLINE_TOKEN_BUDGET=6000
MAX_UPLOAD_BYTES=104857600

# --- Auth (§4, §10) ---
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# --- Tool loop (§7) ---
MAX_TOOL_ITERATIONS=6
MAX_PARALLEL_TOOLS=2

# --- CORS (dev split-origin only; prod is same-origin via proxy; §2) ---
# CORS_ORIGINS=["http://localhost:5173"]

# --- System prompt (§7): the Citya persona + Indonesian rule.
#     Unset  = the built-in default (app/chat/prompt.py).
#     Set    = replaces it.
#     Empty  = no system message at all (raw model behaviour).
# SYSTEM_PROMPT=Kamu adalah Citya, asisten kota. Selalu jawab dalam Bahasa Indonesia.
