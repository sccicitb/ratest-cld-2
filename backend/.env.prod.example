# Production environment — copy to backend/.env on the Windows host.
# Replace all <placeholder> values before running.

# --- App data store (§9.1): SQLite is fine for a single-user/small-team deploy.
#     Switch to Postgres by changing the URL; SQLAlchemy handles both.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg2://user:password@<DB_HOST>:5432/ragdb

# --- Vector store (§9.2): Qdrant runs on the Hyper-V Linux VM.
#     Set <VM_IP> to the VM's IP address (see DEPLOY.md §2 — Hyper-V networking).
QDRANT_URL=http://<VM_IP>:6333
QDRANT_COLLECTION=kb_chunks

# --- Code-exec sandbox (§13): code-exec service runs on the Linux VM.
CODE_EXEC_URL=http://<VM_IP>:8001
CODE_EXEC_TIMEOUT_SECONDS=60

# --- Chat model: OpenAI-compatible endpoint (§7/§12).
MODEL_BASE_URL=http://<LLAMA_SERVER_HOST>/v1
MODEL_NAME=qwen
MODEL_API_KEY=not-needed

# --- Embeddings / rerank (FlagEmbedding/BGE-M3, in-process on the GPU host; §8.1/§8.5).
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=false
# cuda|mps|cpu — set explicitly on the Windows Server GPU host.
EMBED_DEVICE=cuda
# EMBED_USE_FP16=true   # recommended for CUDA; blank = auto

# --- Auth (§4/§10): generate a strong random secret (32+ bytes).
JWT_SECRET=<replace-with-32-or-more-random-bytes>
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Secure=true is required for the httpOnly refresh cookie over HTTPS (Cloudflare Tunnel).
COOKIE_SECURE=true

# --- CORS: same origin in prod (FastAPI serves the SPA); set to empty or omit.
#     If you need split-origin for any reason, list the frontend domain here.
CORS_ORIGINS=

# --- SPA serving (§11): path to the built frontend, relative to the backend/ dir.
#     The frontend build output is frontend/build/client (react-router v7 default).
SPA_DIR=../frontend/build/client

# --- Ingress routing (§6).
INLINE_TOKEN_BUDGET=6000
MAX_UPLOAD_BYTES=104857600   # 100 MiB

# --- Tool loop safety rails (§7).
MAX_TOOL_ITERATIONS=6
MAX_PARALLEL_TOOLS=2

# --- OCR (§6/§8.1): Surya, in-process.
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=100
